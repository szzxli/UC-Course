 {
  "campus": "UCSB",
  "dept": "MUS CS",
  "code": "MUS CS 105SY",
  "title": "Synths and Sci-Fi Cinema",
  "units": "0",
  "description": "Explore the intersection of \"synths\" and sci-fi cinema in this course. We'll analyze iconic film scores and director/composer collaborations from the 1950s to today, including Kubrick/Carlos and Nolan/Zimmer. The course blends viewing sessions with discussions, presentations, and performances. Students have the opportunity to compose or improvise their own sci-fi soundscapes.",
  "prerequisites_raw": "",
  "prerequisites_courses": []
 },
 {
  "campus": "UCSB",
  "dept": "MUS CS",
  "code": "MUS CS 105WP",
  "title": "Writing for Piano",
  "units": "0",
  "description": "Although one of the most commonly used instruments, piano can still be one of the trickiest instruments to master compositionally. In this course, we cover decades of styles, writing for solo piano, piano in chamber music, piano duo, & piano in orchestra. We also cover piano reductions and arranging for piano. Most assignments are small compositions and a final composition project.",
  "prerequisites_raw": "",
  "prerequisites_courses": []
 },
